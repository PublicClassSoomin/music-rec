# 복사: cp .env.example .env  후 값 채우기 (.env 는 Git 에 올리지 마세요)

# ── Gemini API (선택: langgraph_scenario 질의 보강에 사용, 없으면 원문 질의만 임베딩) ──
GEMINI_API_KEY=
# 발급: https://aistudio.google.com/app/apikey
# 무료 발급 가능
# 이거 KEY 수민이 꺼니까 아껴주세요 !!!

# LLM_MODEL=gemini-1.5-flash
# langgraph_scenario: 임베딩 후보만 보여 주고 Gemini가 그중 top-3 곡 id 선택 (키 있을 때, SCENARIO_LLM_TOP3=true)
# SCENARIO_LLM_TOP3=true
# SCENARIO_LLM_CANDIDATES=18

# 경량 CPU 임베딩 (기본: 다국어 MiniLM, 한국어 시나리오 질의 권장)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 저사양: 배치·스레드 축소
# EMBEDDING_BATCH_SIZE=4
# TORCH_NUM_THREADS=2

# ── JWT (회원가입·로그인 토큰) ─────────────────
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ── DB ────────────────────────────────────────
DB_PATH=./music_rec.db
# 기본값 그대로 써도 됨

# ── 멜론 파이프라인: 가사 수집 (저작권·약관은 직접 확인) ──
# MELON_FETCH_LYRICS=true
# MELON_LYRIC_DELAY_SEC=0.45
# LYRIC_EMBED_MAX_CHARS=1500
# librosa 특성: 앞 N초만(기본 30). 전곡이면 0 또는 음수 (RAM·시간 많이 듦).
# MAX_AUDIO_DURATION=0

# YouTube(yt-dlp) 봇 차단 시 거의 필수 — cookies.txt 경로 또는 로그인된 브라우저
# https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
# YOUTUBE_COOKIES_FILE=/absolute/path/to/cookies.txt
# YOUTUBE_COOKIES_FROM_BROWSER=chrome

# ── 오디오 임시 경로 (참고) ───────────────────
# 멜론 파이프라인은 현재 tempfile 임시 디렉터리를 씁니다. 아래는 예비/문서용.
TEMP_AUDIO_PATH=./temp_audio

# ── 선택: YouTube Data API v3 ─────────────────
# YOUTUBE_API_KEY=
