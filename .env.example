# 복사: cp .env.example .env  후 값 채우기 (.env 는 Git 에 올리지 마세요)

# SQLite DB 파일 경로
DB_PATH=./music_rec.db

# JWT — 배포·공유 환경에서는 반드시 긴 랜덤 문자열로 변경
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_HOURS=24

# 선택: LangChain / LangGraph 에서 Gemini 사용 시
# GEMINI_API_KEY=

# 선택: YouTube Data API v3 를 쓰는 별도 스크립트가 있을 때
# YOUTUBE_API_KEY=